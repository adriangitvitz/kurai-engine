# Kurai environment. `make setup` copies this file to `.env` and fills in the
# two secrets. Docker Compose reads `.env` automatically.
# After editing `.env`, apply it with: make redeploy

# --- Secrets ----------------------------------------------------------------
# Both are generated by `make setup`. Leave them empty here.
# KURAI_AUTH_SECRET signs session cookies (base64, at least 32 bytes).
# SEARXNG_SECRET is the SearXNG instance secret.
KURAI_AUTH_SECRET=
SEARXNG_SECRET=

# --- Authentication ---------------------------------------------------------
# Off by default: anyone who can reach the ports can search. Turn it on before
# exposing Kurai beyond your own machine, then add users to `users.yaml`
# (see `users.example.yaml`).
KURAI_AUTH_ENABLED=false

# --- Synthesized answers and deep research (OpenRouter) ---------------------
# Optional. With OPENROUTER_API_KEY empty the UI stays in sources-only mode.
OPENROUTER_API_KEY=
# Model for the final answer. Any model id enabled on your OpenRouter account.
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Cheaper model for deep research's planning and per-source summaries.
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5

# --- Search providers -------------------------------------------------------
# SearXNG is always on. Tavily is an optional fallback, used only when SearXNG
# returns few results.
KURAI_TAVILY_ENABLED=false
TAVILY_API_KEY=

# --- Result liveness probe --------------------------------------------------
# Dead links are dropped from results by default (see `probe:` in config.yaml).
# Uncomment to override. DROP=false keeps them and marks them unreachable.
# KURAI_PROBE_ENABLED=true
# KURAI_PROBE_DROP_UNREACHABLE=true

# --- Logging ----------------------------------------------------------------
# debug, info, warn or error.
KURAI_LOG_LEVEL=info

# Keep the Docker build context small and — critically — keep local secrets
# out of the image. The Dockerfile does `COPY . .`, so without this file
# web/.env.local (which holds OPENROUTER_API_KEY) would be baked into the image.
node_modules
.next
out
.git
.gitignore

# Local env files with secrets — provide these at RUNTIME via compose, never bake them.
.env
.env.local
.env*.local

# Dev / tooling cruft
npm-debug.log*
.DS_Store
*.tsbuildinfo
README*.md

# E2E harness artifacts (dev-only)
test-results
playwright-report
